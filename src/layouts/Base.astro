---
import { SITE, AFFILIATE, ANALYTICS } from '../config';
import { u } from '../lib/url';
import OpenNow from '../components/OpenNow.astro';
import { meta, clip, otherCategories } from '../lib/data';
import { LANGS, DEFAULT_LANG, langOf, dePath, lp, isTranslated, fmt } from '../i18n';
interface Props { title: string; description: string; crumbs?: { href: string; label: string }[]; noindex?: boolean; jsonLd?: object[] }
const { title, crumbs = [], noindex = false, jsonLd = [] } = Astro.props;
const description = clip(Astro.props.description);
const canonical = new URL(Astro.url.pathname, Astro.site);
const abs = (path: string) => new URL(u(path), Astro.site).href;
// Sprache aus dem Pfad: / = Deutsch, /en/ = Englisch usw. (src/i18n)
const rel = '/' + Astro.url.pathname.slice(import.meta.env.BASE_URL.length).replace(/^\//, '');
const lang = langOf(rel), T = LANGS[lang], de = lang === DEFAULT_LANG;
const basePath = dePath(rel), translated = isTranslated(rel);
// Gegenstücke in allen Sprachen (für hreflang und den Sprachhinweis)
const alternates = translated ? Object.keys(LANGS).map((l) => ({ lang: l, href: abs(lp(l, basePath)) })) : [];
// Flaggen für alle Sprachen: aktuelle markiert, die anderen verlinken auf dieselbe Seite in der anderen Sprache (oder deren Startseite)
const flags = Object.keys(LANGS).map((l) => ({ code: l, flag: LANGS[l].flag, label: LANGS[l].switchTo, current: l === lang, href: u(translated ? lp(l, basePath) : lp(l, '/')) }));
const otherLangs = Object.keys(LANGS).filter((l) => l !== lang).map((l) => ({ code: l, name: LANGS[l].name, offer: LANGS[l].offer, yes: LANGS[l].offerYes, no: LANGS[l].offerNo, href: u(translated ? lp(l, basePath) : lp(l, '/')), page: translated }));
const navCats = otherCategories.filter((c) => T.cats[c.key]);
const ld = [...jsonLd];
if (crumbs.length) ld.push({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [{ href: lp(lang, '/'), label: T.start }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: abs(c.href) })),
});
---
<!doctype html>
<html lang={T.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={LANGS[a.lang].htmlLang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    {(!SITE.indexing || noindex) && <meta name="robots" content={SITE.indexing ? 'noindex, follow' : 'noindex, nofollow'} />}
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={T.ogLocale} />
  </head>
  <body data-oh-open={T.oh.open} data-oh-closed={T.oh.closed}>
    <div id="lang-offer" class="lang-offer" hidden data-langs={JSON.stringify(otherLangs.filter((o) => o.page))}></div>
    <header class="site-header">
      <div class="wrap">
        <div class="brand">
          <a class="logo" href={u(lp(lang, '/'))}><span aria-hidden="true">✚</span> {SITE.name}<small class="claim">{de ? SITE.claim : T.claim}</small></a>
          <div class="lang-flags">
            {flags.map((f) => f.current
              ? <span class="flag on" aria-current="true" title={f.label} lang={LANGS[f.code].htmlLang}><Fragment set:html={f.flag} /><span class="sr">{f.label}</span></span>
              : <a class="flag" href={f.href} hreflang={LANGS[f.code].htmlLang} lang={LANGS[f.code].htmlLang} title={f.label}><Fragment set:html={f.flag} /><span class="sr">{f.label}</span></a>)}
          </div>
        </div>
        <nav aria-label={T.navLabel}>
          {!de && navCats.map((c) => <a href={u(lp(lang, `/${c.slug}/`))}>{T.cats[c.key].label}</a>)}
          {de && <>
          <a href={u('/karte/')}>Karte</a>
        <a href={u('/plz/')}>PLZ</a>
        <a href={u('/leistung/')}>Leistungen</a>
          <a href={u('/hausarzt/')}>Hausärzte</a>
          <a href={u('/physiotherapie/')}>Physiotherapie</a>
          <a href={u('/fusspflege/')}>Fußpflege</a>
          <a href={u('/rehasport/')}>Rehasport</a>
          <a href={u('/pflegedienst/')}>Pflegedienste</a>
          <a href={u('/krankenfahrten/')}>Krankenfahrten</a>
          <a href={u('/pflegeheim/')}>Pflegeheime</a>
          <a href={u('/pflegeprodukte/')}>Pflegeprodukte</a>
          <a href={u('/alltagshelfer/')}>Alltagshelfer</a>
          <a href={u('/ratgeber/')}>Ratgeber</a>
          <a href={u('/fuer-sanitaetshaeuser/')}>Für Sanitätshäuser</a>
          </>}
        </nav>
      </div>
    </header>
    <main class="wrap">
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label={T.crumbsLabel}>
          <a href={u(lp(lang, '/'))}>{T.start}</a>
          {crumbs.map((c) => (<><span aria-hidden="true">›</span><a href={u(c.href)}>{c.label}</a></>))}
        </nav>
      )}
      <slot />
    </main>
    <OpenNow />
    <footer class="site-footer">
      <div class="wrap">
        <p set:html={fmt(T.footerData, { osm: `<a href="https://www.openstreetmap.org/copyright">${T.osmContributors}</a>`, date: new Date(meta.osmFetchedAt).toLocaleDateString(T.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' }) })} />
        {de ? <>{(AFFILIATE.amazonTag || AFFILIATE.pflegeboxUrl || AFFILIATE.sanishopUrl || AFFILIATE.hausnotrufUrl) && <p>Mit „Werbung“ gekennzeichnete Links sind Partnerlinks. Kaufen Sie darüber, erhalten wir eine Provision, für Sie ändert sich der Preis nicht.{AFFILIATE.amazonTag && ' Als Amazon-Partner verdienen wir an qualifizierten Verkäufen.'}</p>}
        <p><a href={u('/ueber/')}>So entstehen die Daten</a> · <a href={u('/bundesland/')}>Bundesländer</a> · <a href={u('/eintrag/')}>Eintrag ergänzen oder melden</a> · <a href={u('/fuer-sanitaetshaeuser/')}>Für Betriebe</a> · <a href={u('/warum/')}>Warum diese Seite</a> · <a href={u('/impressum/')}>Impressum</a> · <a href={u('/datenschutz/')}>Datenschutz</a> · <a href="#statistik" id="stat-settings">Statistik-Einstellungen</a></p></>
        : <><p>{T.legalNote}</p><p><a href={u('/')} hreflang="de" lang="de">{T.footer.german}</a> · <a href={u('/impressum/')} hreflang="de">{T.footer.impressum}</a> · <a href={u('/datenschutz/')} hreflang="de">{T.footer.datenschutz}</a> · <a href={u('/eintrag/')} hreflang="de">{T.footer.eintrag}</a> · <a href="#statistik" id="stat-settings">{T.stat.settings}</a></p></>}
      </div>
    </footer>
    <button type="button" id="stat-fab" class="stat-fab" aria-label={T.stat.settings} title={T.stat.settings} hidden><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></button>
    <div id="stat-banner" class="stat-banner" role="dialog" aria-modal="true" aria-labelledby="stat-h" hidden>
      <p id="stat-h"><strong>{T.stat.heading}</strong> {fmt(T.stat.text, { cf: ANALYTICS.cloudflareToken ? T.stat.cf : '' })} <a href={u('/datenschutz/')}>{T.stat.more}</a></p>
      <p class="stat-btns"><button type="button" class="btn" data-stat="nein">{T.stat.no}</button> <button type="button" class="btn" data-stat="ja">{T.stat.yes}</button></p>
    </div>
    <script>
      // Sprachhinweis: passt die Browsersprache zu einer Übersetzung dieser Seite, einmal anbieten. Keine automatische Umleitung.
      (() => {
        const box = document.getElementById('lang-offer') as HTMLElement, K = 'sh-sprache';
        let langs: { code: string; offer: string; yes: string; no: string; href: string }[] = []; try { langs = JSON.parse(box.dataset.langs || '[]'); } catch {}
        let saved = null; try { saved = localStorage.getItem(K); } catch {}
        if (saved || !langs.length) return;
        const here = document.documentElement.lang;
        const pref = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || '']).map((l) => String(l).slice(0, 2).toLowerCase());
        if (!pref.length || pref[0] === here) return;
        const o = langs.find((x) => x.code === pref[0]);
        if (!o) return;
        const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as Record<string, string>)[c]);
        box.innerHTML = `<p lang="${esc(o.code)}"><span>${esc(o.offer)}</span> <a class="btn" href="${esc(o.href)}" hreflang="${esc(o.code)}">${esc(o.yes)}</a> <button type="button" class="lang-no">${esc(o.no)}</button></p>`;
        box.hidden = false;
        const remember = (v: string) => { try { localStorage.setItem(K, v); } catch {} };
        box.querySelector('a')!.addEventListener('click', () => remember(o.code));
        box.querySelector('.lang-no')!.addEventListener('click', () => { remember(here); box.hidden = true; });
      })();
    </script>
    <script is:inline define:vars={{ CF: ANALYTICS.cloudflareToken }}>
      // Zählung: ohne Einwilligung nur ein Zählbild mit der Seitenadresse (kein Zugriff auf das Endgerät),
      // mit Einwilligung (§ 25 Abs. 1 TDDDG) das GoatCounter-Skript. Gespeichert wird nur die Entscheidung selbst.
      (() => {
        const KEY = CF ? 'sh-statistik-4' : 'sh-statistik-3', // neuer Schlüssel = alle werden neu gefragt, sobald Cloudflare dazukommt
           ban = document.getElementById('stat-banner');
        const GC = 'https://sanitaetshaus-suche.goatcounter.com/count';
        // CF: Token für Cloudflare Web Analytics aus src/config.ts, wird nur mit Einwilligung geladen
        const pixel = () => { new Image().src = `${GC}?p=${encodeURIComponent(location.pathname)}&rnd=${Math.random().toString(36).slice(2)}`; };
        const get = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
        const load = () => { const s = document.createElement('script'); s.async = true; s.src = 'https://gc.zgo.at/count.js'; s.dataset.goatcounter = GC; document.head.appendChild(s); if (CF) { const c = document.createElement('script'); c.defer = true; c.src = 'https://static.cloudflareinsights.com/beacon.min.js'; c.dataset.cfBeacon = JSON.stringify({ token: CF }); document.head.appendChild(c); } };
        // Klicks auf die Kontakt-Knöpfe eines Eintrags zählen (ohne Einwilligung als Zählbild wie oben, nur die Ereignis-Adresse).
        // Name des Ereignisses: klick/<art>/<eintrags-id>, z. B. klick/telefon/sanitaetshaus/node-123. Auswertung je Betrieb: siehe docs/klickzaehlung.md
        document.addEventListener('click', (ev) => {
          const a = ev.target.closest && ev.target.closest('a.k');
          if (!a || a.classList.contains('k-add')) return;
          const box = a.closest('[data-eid]'), eid = box && box.dataset.eid;
          if (!eid) return;
          const h = a.getAttribute('href') || '';
          const art = h.startsWith('tel:') ? 'telefon' : h.startsWith('mailto:') ? 'email' : a.classList.contains('k-book') ? 'buchung' : h.includes('google.com/maps') ? 'route' : 'website';
          const path = `klick/${art}/${eid}`, title = box.dataset.n || '';
          if (window.goatcounter && window.goatcounter.count) window.goatcounter.count({ path, title, event: true });
          else new Image().src = `${GC}?p=${encodeURIComponent(path)}&t=${encodeURIComponent(title)}&e=true&rnd=${Math.random().toString(36).slice(2)}`;
        });
        const fab = document.getElementById('stat-fab');
        fab.addEventListener('click', () => show());
        const show = () => { ban.hidden = false; fab.hidden = true; document.documentElement.classList.add('stat-open'); ban.querySelector('[data-stat="ja"]').focus({ preventScroll: true }); };
        const set = (v) => { try { localStorage.setItem(KEY, v); } catch {} ban.hidden = true; fab.hidden = false; document.documentElement.classList.remove('stat-open'); if (v === 'nein' && window.goatcounter) location.reload(); };
        ban.addEventListener('click', (e) => { const b = e.target.closest('[data-stat]'); if (b) set(b.dataset.stat); });
        document.getElementById('stat-settings').addEventListener('click', (e) => { e.preventDefault(); show(); });
        const v = get();
        // Der Aufruf dieser Seite wird genau einmal gezählt: mit Einwilligung über das Skript, sonst über das Zählbild
        if (v === 'ja') load(); else pixel();
        if (v !== 'ja' && v !== 'nein') show(); else fab.hidden = false;
      })();
    </script>
  </body>
</html>
<style is:global>
  .shop.nocontact .card { background: #fafafa; }
  .shop.nocontact, .shop.nocontact a, .shop.nocontact h3, .shop.nocontact .addr { color: #9a9a9a; }
  :root {
    --bg: #f7f8f7; --surface: #ffffff; --text: #1b2421; --muted: #55625d; --line: #d9dfdc;
    --brand: #0f6b57; --brand-ink: #ffffff; --accent: #e7f3ef; --gold: #8a5a00; --gold-bg: #fff4dc;
    --radius: 10px;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 18px; line-height: 1.55; color: var(--text); background: var(--bg);
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); }
  a { color: var(--brand); }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
  .site-header { background: var(--brand); color: var(--brand-ink); }
  .site-header .wrap { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; justify-content: space-between; padding-top: 14px; padding-bottom: 14px; }
  .site-header a { color: var(--brand-ink); text-decoration: none; }
  .logo { font-weight: 700; font-size: 1.15rem; }
  .logo .claim { display: block; font-weight: 400; font-size: 0.85rem; color: rgba(255,255,255,0.9); margin-left: 1.4em; }
  .site-header nav { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 0.95rem; }
  .site-header nav a:hover { text-decoration: underline; }
  main { padding-top: 20px; padding-bottom: 48px; min-height: 60vh; }
  h1 { font-size: 1.9rem; line-height: 1.2; margin: 0.3em 0 0.4em; }
  h2 { font-size: 1.35rem; margin: 1.6em 0 0.5em; }
  .lead { font-size: 1.1rem; color: var(--muted); max-width: 46em; }
  .crumbs { font-size: 0.85rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: 6px; }
  .crumbs a { color: var(--muted); }
  .site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; padding: 18px 0 32px; }
  .site-footer a { color: var(--muted); }
  .stat-banner { position: fixed; z-index: 2000; inset: 0; display: grid; place-items: center; padding: 16px; background: rgba(0,0,0,.55); font-size: .95rem; }
  .stat-banner > * { max-width: 520px; width: 100%; }
  .stat-banner > p:first-child { background: var(--surface); border-radius: var(--radius) var(--radius) 0 0; padding: 18px 18px 6px; margin: 0 !important; align-self: end; }
  .stat-banner > .stat-btns { background: var(--surface); border-radius: 0 0 var(--radius) var(--radius); padding: 10px 18px 18px; align-self: start; }
  html.stat-open { overflow: hidden; }
  .stat-fab { position: fixed; z-index: 1500; left: 14px; bottom: 14px; width: 44px; height: 44px; border-radius: 50%; border: 0; background: var(--brand); color: var(--brand-ink); display: grid; place-items: center; cursor: pointer; box-shadow: 0 4px 14px rgba(0,0,0,.2); }
  .stat-fab[hidden] { display: none; }
  .lang-offer { position: relative; z-index: 2100; background: #fff4dc; color: var(--text); border-bottom: 1px solid var(--line); }
  .lang-offer[hidden] { display: none; }
  .lang-offer p { max-width: 1040px; margin: 0 auto; padding: 10px 16px; display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; font-size: .95rem; }
  .lang-offer .btn { padding: 6px 14px; }
  .lang-offer .lang-no { font: inherit; font-size: .95rem; background: none; border: 0; color: var(--brand); text-decoration: underline; cursor: pointer; padding: 6px 4px; }
  .brand { display: flex; align-items: flex-start; gap: 6px 18px; min-width: 0; }
  .lang-flags { display: flex; gap: 6px; align-items: center; flex-shrink: 0; }
  .lang-flags .flag { display: inline-flex; padding: 3px; border-radius: 4px; border: 2px solid transparent; line-height: 0; }
  .lang-flags .flag svg { display: block; box-shadow: 0 0 0 1px rgba(255,255,255,.6); }
  .lang-flags a.flag { opacity: .75; }
  .lang-flags a.flag:hover, .lang-flags a.flag:focus-visible { opacity: 1; border-color: rgba(255,255,255,.8); }
  .lang-flags .flag.on { border-color: #fff; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .stat-banner[hidden] { display: none; }
  .stat-banner p { margin: 0 0 10px; }
  .stat-btns { display: flex; gap: 10px; margin: 0 !important; }
  .stat-btns .btn { flex: 1; border: 0; cursor: pointer; font-size: 1rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; padding: 0; list-style: none; }
  .grid a.tile { display: block; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 14px; text-decoration: none; color: var(--text); }
  .grid a.tile:hover { border-color: var(--brand); }
  .tile small { display: block; color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 8px 0; list-style: none; }
  .chip { background: var(--accent); color: var(--brand); border-radius: 999px; padding: 2px 10px; font-size: 0.82rem; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; }
  .note { background: var(--gold-bg); color: var(--gold); border-radius: var(--radius); padding: 12px 14px; font-size: 0.92rem; }
  .muted { color: var(--muted); }
  .btn { display: inline-block; background: var(--brand); color: var(--brand-ink); padding: 10px 16px; border-radius: 8px; text-decoration: none; font-weight: 600; }
  input[type=search] { width: 100%; font-size: 1.05rem; padding: 12px 14px; border: 2px solid var(--line); border-radius: var(--radius); }
  input[type=search]:focus { outline: none; border-color: var(--brand); }
  @media (max-width: 600px) {
    h1 { font-size: 1.5rem; } :root { font-size: 17px; }
    .brand { gap: 10px; }
    .lang-flags { gap: 4px; }
    .site-header nav { flex-wrap: nowrap; overflow-x: auto; width: 100%; padding-bottom: 4px; white-space: nowrap; }
  }
</style>
