---
import Base from '../../layouts/Base.astro';
import ShopList from '../../components/ShopList.astro';
import Map from '../../components/Map.astro';
import Faq from '../../components/Faq.astro';
import PflegeboxHinweis from '../../components/PflegeboxHinweis.astro';
import ProviderList from '../../components/ProviderList.astro';
import { u } from '../../lib/url';
import { cities, shopsInCity, features, nearbyCities, meta, fmtDate, fit, otherCategories, providers } from '../../lib/data';
import { km } from '../../lib/geo';
export function getStaticPaths() {
  return cities.map((c) => ({ params: { city: c.slug }, props: { city: c } }));
}
const { city } = Astro.props;
const list = shopsInCity(city.slug);
const n = list.length;
const one = n === 1;
const near = nearbyCities(city, 10);
const feats = features.map((f) => ({ ...f, shops: list.filter((s) => s.features.includes(f.key)) })).filter((f) => f.shops.length > 0);
const accessible = list.filter((s) => s.wheelchair === 'yes').length;
const featCount = (k: string) => feats.find((f) => f.key === k)?.shops.length ?? 0;
const names = (k: string) => feats.find((f) => f.key === k)?.shops.slice(0, 3).map((s) => s.name).join(', ');
const where = `in ${city.label}`;

const faq = [
  { q: `Welche Sanitätshäuser gibt es ${where}?`, a: `Zum Beispiel ${list.slice(0, 3).map((s) => s.name).join(', ')}. Alle Adressen mit Telefon und Route stehen oben auf dieser Seite. Stand der Adressen: ${fmtDate(meta.osmFetchedAt)}.` },
  { q: `Welches Sanitätshaus ${where} macht Hausbesuche?`, a: featCount('hausbesuch') ? `Laut eigener Website bieten zum Beispiel diese Häuser Hausbesuche an: ${names('hausbesuch')}.` : `Auf den Websites der Häuser ${where} haben wir keinen Hinweis auf Hausbesuche gefunden. Fragen Sie trotzdem nach, viele Häuser liefern auf Rezept nach Hause. Häuser mit Hausbesuch in der Nähe finden Sie unter „Hausbesuche“.` },
  { q: `Wo bekomme ich ${where} Flachstrick-Kompression bei Lip- oder Lymphödem?`, a: featCount('lymph') ? `Flachstrick oder Lymph-Versorgung nennen zum Beispiel ${names('lymph')}.` : `Keines der Häuser ${where} nennt Flachstrick auf seiner Website. In der Liste „Lymph- und Lipödem-Versorgung“ finden Sie Häuser in der Umgebung.` },
  { q: 'Brauche ich ein Rezept?', a: 'Für Hilfsmittel, die die Krankenkasse bezahlen soll, brauchen Sie eine Verordnung vom Arzt. Gesetzlich Versicherte zahlen meist 10 % zu, mindestens 5 € und höchstens 10 € pro Hilfsmittel. Ob ein Haus mit Ihrer Kasse einen Vertrag hat, fragen Sie am besten vorher telefonisch.' },
];
const itemList = { '@context': 'https://schema.org', '@type': 'ItemList', name: `Sanitätshäuser ${where}`, numberOfItems: n,
  itemListElement: list.slice(0, 50).map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(u(`/sanitaetshaus/${s.slug}/`), Astro.site).href, name: s.name })) };
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
// Weitere Hilfe direkt auf der Seite: die nächsten Einträge je Kategorie (im Ort, sonst bis 25 km)
const more = otherCategories.map((c) => {
  const items = providers.filter((p) => p.cat === c.key && p.lat).map((p) => ({ p, km: km(city, p) })).filter((x) => x.p.citySlug === city.slug || x.km <= 25)
    .sort((a, b) => Number(!(a.p.phone || a.p.website)) - Number(!(b.p.phone || b.p.website)) || a.km - b.km).slice(0, 6);
  return { c, items, hasPage: (city.counts[c.key] || 0) > 0 };
}).filter((m) => m.items.length);
const topFeat = feats.slice().sort((a, b) => b.shops.length - a.shops.length).slice(0, 3).map((f) => f.label);
---
<Base
  title={fit([`Sanitätshaus ${city.label}: Adresse, Telefon, Öffnungszeiten (${new Date(meta.builtAt).getFullYear()})`, `Sanitätshaus ${city.label}: Adresse, Telefon, Öffnungszeiten`, `Sanitätshaus ${city.label}: Adressen nach Leistung`, `Sanitätshaus ${city.label}`])}
  description={`Sanitätshaus ${where} mit Adresse, Telefon und Öffnungszeiten.${topFeat.length ? ' Filter: ' + topFeat.join(', ') + '.' : ''}`}
  jsonLd={[itemList, faqLd]}
  crumbs={[{ href: `/bundesland/${city.stateSlug}/`, label: city.state }, { href: `/stadt/${city.slug}/`, label: city.label }]}>
  <h1>Sanitätshäuser in {city.label}</h1>
  <p class="lead">
    {one ? 'Das Sanitätshaus' : 'Die Sanitätshäuser'} in {city.label}{city.district && city.district !== city.name ? ` (${city.district})` : ''} mit Telefon, Öffnungszeiten und Route.
    {feats.length > 0 ? ' Häuser mit mehr erkannten Leistungen stehen oben. Filtern Sie nach dem, was Sie brauchen.' : ''}
  </p>
  <nav class="jump" aria-label="Auf dieser Seite">
    <a href="#liste">Sanitätshäuser</a>
    {more.map((m) => <a href={`#${m.c.slug}`}>{m.c.label}</a>)}
    <a href="#fragen">Fragen</a>
  </nav>
  {feats.length > 0 && (
    <ul class="chips">{feats.map((f) => <li><a class="chip" href={u(`/leistung/${f.slug}/${city.slug}/`)}>{f.label}</a></li>)}</ul>
  )}
  <Map shops={list} />
  <div id="liste"><ShopList shops={list} /></div>
  {more.map((m) => (
    <section class="more" id={m.c.slug}>
      <h2>{m.c.label} in {city.label} und Umgebung</h2>
      <ProviderList items={m.items} cat={m.c.key} showCity={true} filter={false} />
      {m.hasPage && <p><a href={u(`/${m.c.slug}/${city.slug}/`)}>Alle Einträge: {m.c.label} in {city.label}</a></p>}
    </section>
  ))}
  <PflegeboxHinweis />
  <Faq items={faq} />
  <h2>Sanitätshäuser in der Nähe von {city.label}</h2>
  <ul class="grid">{near.map((c) => (<li><a class="tile" href={u(`/stadt/${c.slug}/`)}>{c.label}<small>{Math.round(c.km)} km entfernt</small></a></li>))}</ul>
</Base>
<style>.chip { text-decoration: none; display: inline-block; }
  .jump { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 4px 0 10px; font-size: .95rem; }</style>
