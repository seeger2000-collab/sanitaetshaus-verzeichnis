---
import Base from '../../layouts/Base.astro';
import { u } from '../../lib/url';
import { GUIDES } from '../../lib/ratgeber';
import { BEGRIFFE } from '../../lib/begriffe';
const begriffe = Object.values(BEGRIFFE).sort((a, b) => a.term.localeCompare(b.term, 'de'));
---
<Base title="Ratgeber: Hilfsmittel, Pflegegrad, Rezept und Krankenkasse" description="Antworten mit Gesetzesangabe auf die häufigsten Fragen: Pflegegrad beantragen, Pflegebett, Rollator auf Rezept, Kompressionsstrümpfe, Einlagen, Pflegebox, Krankenfahrten, Treppenlift und Badumbau." crumbs={[{ href: '/ratgeber/', label: 'Ratgeber' }]}>
  <h1>Ratgeber</h1>
  <p class="lead">Die Fragen, die Menschen am häufigsten zu Hilfsmitteln, Pflege und Kosten stellen. Jede Kostenaussage nennt die Vorschrift, aus der sie folgt.</p>
  <ul class="grid">{GUIDES.map((g) => <li><a class="tile" href={u(`/ratgeber/${g.slug}/`)}>{g.h1}</a></li>)}</ul>
  <section id="begriffe">
    <h2>Begriffe von A bis Z</h2>
    {begriffe.map((b) => (
      <aside class="begriff">
        <p class="begriff-term">{b.term}</p>
        <p>{b.def}</p>
        <p class="begriff-quelle"><small>Quelle: <span set:html={b.quelle} /></small></p>
      </aside>
    ))}
  </section>
</Base>
<style>
  #begriffe { max-width: 46em; margin-top: 2em; }
  .begriff { background: var(--accent); border-left: 4px solid var(--brand); border-radius: var(--radius); padding: 12px 16px; margin: 0 0 12px; }
  .begriff p { margin: 0 0 0.4em; }
  .begriff-term { font-weight: 700; color: var(--brand); }
  .begriff-quelle { margin: 0 !important; color: var(--muted); }
</style>
