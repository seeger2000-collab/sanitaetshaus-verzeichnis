---
import Base from '../../layouts/Base.astro';
import Finder from '../../components/Finder.astro';
import { otherCategories, categories } from '../../lib/data';
import { CATEGORY_TEXT } from '../../lib/categoryText';
export function getStaticPaths() {
  return otherCategories.map((cat) => ({ params: { cat: cat.slug }, props: { cat } }));
}
const { cat } = Astro.props;
const text = CATEGORY_TEXT[cat.key];
---
<Base title={`${cat.label} in Ihrer Nähe: Adressen nach Ort`} description={`${cat.label} in Ihrer Nähe finden: Ort oder PLZ eingeben, mit Karte, Telefon und Route. ${text.intro}`} crumbs={[{ href: `/${cat.slug}/`, label: cat.label }]}>
  <h1>{cat.label} in Ihrer Nähe</h1>
  <p class="lead">{text.intro}</p>
  <Finder preset={{ kind: 'cat', i: categories.findIndex((c) => c.key === cat.key), label: cat.label, current: `/${cat.slug}/` }} />
</Base>
