---
import { stripTags } from '../../lib/recht';
import Base from '../../layouts/Base.astro';
import ProviderList from '../../components/ProviderList.astro';
import Map from '../../components/Map.astro';
import Faq from '../../components/Faq.astro';
import { u } from '../../lib/url';
import { km } from '../../lib/geo';
import { otherCategories, providersByCat, allCities, fit } from '../../lib/data';
import { CATEGORY_TEXT } from '../../lib/categoryText';
export function getStaticPaths() {
  return otherCategories.flatMap((cat) => {
    const list = providersByCat(cat.key);
    return allCities.filter((c) => c.counts[cat.key]).map((city) => ({ params: { cat: cat.slug, city: city.slug }, props: { cat, city, list } }));
  });
}
const { cat, city, list } = Astro.props;
const text = CATEGORY_TEXT[cat.key];
const local = list.filter((p) => p.citySlug === city.slug).map((p) => ({ p }));
const nearby = local.length >= 8 ? [] : list.filter((p) => p.citySlug !== city.slug).map((p) => ({ p, km: km(city, p) })).filter((x) => x.km <= 25).sort((a, b) => a.km - b.km).slice(0, 10);
const n = local.length;
// Leistungen im Ort (von den Websites der Betriebe erkannt): für Überschriften, Titel und Fragen,
// weil Menschen gezielt suchen, z. B. „manuelle therapie landshut“ (Search Console, 27.11.2026). Keine Anzahl zeigen.
const localFeats = (cat.features || []).map((f) => ({ f, names: local.filter((x) => x.p.features.includes(f.key)).map((x) => x.p.name) }))
  .filter((x) => n >= 3 && x.names.length >= 2).sort((a, b) => b.names.length - a.names.length);
// JS 27.11.2026: nur ausbauen, wo es mehrere Inhalte gibt: Orte ab 3 Einträgen, Leistungen ab 2 Betrieben.
const featList = (names: string[]) => names.slice(0, 4).join(', ') + (names.length > 4 ? ' und weitere' : '');
const featFaq = localFeats.slice(0, 3).map((x) => ({ q: `Wer bietet ${x.f.label} in ${city.label} an?`, a: `Laut eigener Website zum Beispiel ${featList(x.names)}. Rufen Sie vorher an und fragen Sie nach freien Terminen.`, html: false }));
// Für den Titel zuerst, was am häufigsten gesucht wird (Search Console + Autovervollständigung, 27.11.2026)
const GESUCHT = ['hausbesuch', 'manuelle', 'kinder', 'lymphdrainage', 'intensiv', 'demenz', 'palliativ', 'kurzzeit', 'tagespflege'];
const rang = (k: string) => (GESUCHT.indexOf(k) + 1 || 99);
const titleFeats = localFeats.slice().sort((a, b) => rang(a.f.key) - rang(b.f.key) || b.names.length - a.names.length).map((x) => x.f.short);
const featTitle = titleFeats.slice(0, 3).join(', ');
const itemList = { '@context': 'https://schema.org', '@type': 'ItemList', name: text.h1(city.label), numberOfItems: n, itemListElement: local.slice(0, 50).map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x.p.name })) };
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [...featFaq, ...text.faq].map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) } })) };
const nearCities = allCities.filter((c) => c.slug !== city.slug && c.counts[cat.key]).map((c) => ({ ...c, d: km(city, c) })).sort((a, b) => a.d - b.d).slice(0, 8);
---
<Base
  title={fit([...(n >= 3 && titleFeats.length ? [3, 2, 1].map((k) => `${cat.label} ${city.label}: ${titleFeats.slice(0, k).join(', ')}`) : []), text.title(city.label, n), text.title2(city.label), `${cat.label} ${city.label}: Telefon und Adresse`, `${cat.label} ${city.label}`])}
  description={`${cat.label} in ${city.label}${nearby.length ? ' und Umgebung' : ''}: Adresse, Telefon, Öffnungszeiten${featTitle ? ', ' + localFeats.slice(0, 3).map((x) => x.f.label).join(', ') : ' und Leistungen'}. ${text.intro}`}
  jsonLd={[itemList, faqLd]}
  noindex={n < 3}
  crumbs={[{ href: `/${cat.slug}/`, label: cat.label }, { href: `/${cat.slug}/${city.slug}/`, label: city.label }]}>
  <h1>{text.h1(city.label)}</h1>
  <p class="lead">{n === 1 ? cat.one : cat.many} in {city.label}{city.district && city.district !== city.name ? ` (${city.district})` : ''}. {text.intro}</p>
  <Map shops={[...local, ...nearby].map((x) => x.p)} color={cat.color} />
  <ProviderList items={local} cat={cat.key} />
  {nearby.length > 0 && (<>
    <h2>In der Umgebung von {city.label}</h2>
    <ProviderList items={nearby} cat={cat.key} showCity={true} filter={false} />
  </>)}
  {n >= 3 && localFeats.length > 0 && (
    <section class="leistungen-ort">
      <h2>Leistungen in {city.label}</h2>
      {localFeats.map((x) => (<>
        <h3>{x.f.label} in {city.label}</h3>
        <p>Laut eigener Website: {featList(x.names)}.</p>
      </>))}
      <p class="muted"><small>Die Angaben lesen wir automatisch von den Websites der Betriebe. Bitte vor dem Besuch telefonisch bestätigen.</small></p>
    </section>
  )}
  {city.count > 0 && <p class="note">Hilfsmittel wie Rollator, Kompressionsstrümpfe oder Einlagen: <a href={u(`/stadt/${city.slug}/`)}>Sanitätshäuser in {city.label}</a></p>}
  {text.guide && <p><a href={u(text.guide)}>Ratgeber: Wann zahlt die Kasse die Fahrt?</a></p>}
  <Faq items={[...featFaq, ...text.faq.map((f) => ({ ...f, html: true }))]} kasse />
  <h2>{cat.label} in der Nähe</h2>
  <ul class="grid">{nearCities.map((c) => (<li><a class="tile" href={u(`/${cat.slug}/${c.slug}/`)}>{c.label}<small>{Math.round(c.d)} km entfernt</small></a></li>))}</ul>
</Base>
