---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { u } from '../lib/url';
import { cities, states, features, meta, otherCategories } from '../lib/data';
import { GUIDES } from '../lib/ratgeber';
import Finder from '../components/Finder.astro';
import PlzBloecke from '../components/PlzBloecke.astro';
const topCities = [...cities].sort((a, b) => b.count - a.count).slice(0, 24);
---
<Base title="Sanitätshaus in der Nähe finden: nach Bedarf, mit Telefon und Route" jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: new URL(u('/'), Astro.site).href }]} description={`Sanitätshaus in der Nähe finden: Stützstrümpfe, Einlagen, Rollator, Pflegebett. Dazu Physiotherapie, Pflegedienste und Krankenfahrten. Finde Häuser mit Hausbesuch, Flachstrick-Kompression, Brustprothetik, Kinderversorgung oder Rollstuhl-Werkstatt in deiner Nähe.`}>
  <h1>Schnell die passende Hilfe in der Nähe finden</h1>
  <p class="lead">Ort oder Postleitzahl eingeben, auswählen, was Sie brauchen: Sie sehen sofort, wer in der Nähe ist, wie Sie anrufen und wie Sie hinkommen.</p>

  <Finder />

  <h2>Nach Postleitzahl</h2>
  <PlzBloecke />

  <h2>Sanitätshaus-Leistungen</h2>
  <ul class="chips">
    {features.filter((f) => f.count > 0).map((f) => (<li><a class="chip" href={u(`/leistung/${f.slug}/`)}>{f.label}</a></li>))}
  </ul>
  <ul class="chips">
    {otherCategories.map((c) => (<li><a class="chip" href={u(`/${c.slug}/`)}>{c.label}</a></li>))}
    <li><a class="chip" href={u('/karte/')}>Alles auf einer Karte</a></li>
  </ul>

  <h2>Häufige Fragen zu Rezept und Kosten</h2>
  <ul class="grid">{GUIDES.map((g) => <li><a class="tile" href={u(`/ratgeber/${g.slug}/`)}>{g.h1}</a></li>)}</ul>

  <h2>Größte Städte</h2>
  <ul class="grid">
    {topCities.map((c) => (<li><a class="tile" href={u(`/stadt/${c.slug}/`)}>{c.label}</a></li>))}
  </ul>

  <h2>Bundesländer</h2>
  <ul class="grid">
    {states.map((s) => (<li><a class="tile" href={u(`/bundesland/${s.slug}/`)}>{s.name}</a></li>))}
  </ul>
</Base>
<style>.chips .chip { text-decoration: none; display: inline-block; }</style>
