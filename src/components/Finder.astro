---
// Finder auf der Startseite: Bedarf wählen, Ort/PLZ eingeben, Umkreis, Karte mit Treffern und Liste nach Entfernung.
import { u } from '../lib/url';
import { meta, categories } from '../lib/data';
// preset: feste Auswahl auf Leistungs- und Kategorieseiten (nur Ort-Feld). kind: bedarf | feat | cat, i = Index, city = Link-Muster für die Ortsseite mit {slug}
interface Props { preset?: { kind: 'bedarf' | 'feat' | 'cat'; i: number; label: string; city?: string; current?: string } }
const { preset } = Astro.props;
const bedarf = meta.bedarf;
const cats = categories.map((c) => ({ color: c.color, one: c.one }));
const sanIdx = categories.findIndex((c) => c.key === 'sanitaetshaus');
const pages = bedarf.map((b) => ({ label: b.key === 'sanitaetshaus' ? 'Alle Sanitätshäuser' : b.short, href: b.leistung ? `/leistung/${b.leistung}/` : b.seite ? `/${b.seite}/` : '/' }));
---
<section id="finder" class:list={["finder card", { fixed: !!preset }]} aria-labelledby="finder-h" data-preset={preset ? JSON.stringify({ ...preset, san: sanIdx }) : ""}>
  <h2 id="finder-h" class="sr">Suche</h2>
  <form class="fsearch" role="search" action="#" autocomplete="off">
    {!preset && <div class="fq">
      <label for="f-was">Was suchen Sie?</label>
      <input id="f-was" type="search" placeholder="z. B. Stützstrümpfe, Rollator, Physiotherapie oder ein Name" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="f-wsug" />
      <ul id="f-wsug" class="fsug" role="listbox" hidden></ul>
    </div>}
    <div class="fq">
      <label for="f-ort">{preset ? `${preset.label}: Wo suchen Sie?` : 'Wo?'}</label>
      <input id="f-ort" type="search" placeholder="Ort oder PLZ, z. B. Kassel oder 34117" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="f-sug" />
      <ul id="f-sug" class="fsug" role="listbox" hidden></ul>
    </div>
    <div class="frow">
      <button type="button" id="f-loc" class="btn btn-ghost">Mein Standort</button>
      <label class="frad">Umkreis <select id="f-rad"><option value="5">5 km</option><option value="10">10 km</option><option value="25" selected>25 km</option><option value="50">50 km</option><option value="100">100 km</option></select></label>
      <button type="submit" class="btn fgo">Suchen</button>
    </div>
  </form>
  <p class="fhead"><span id="f-msg" aria-live="polite">Geben Sie ein, was Sie brauchen und wo. Die Karte zeigt sofort, wer in der Nähe ist.</span></p>
  <div id="f-map" data-src={u('/data/finder.json')} data-base={u('/')} data-cats={JSON.stringify(cats)} data-bedarf={JSON.stringify(bedarf.map((b) => ({ label: b.key === 'sanitaetshaus' ? 'Sanitätshaus' : b.label, words: b.words || '', leistung: b.leistung, seite: b.seite })))}></div>
  <ol id="f-list" class="flist"></ol>
  <p id="f-more" class="fmore" hidden></p>
  {preset ? <>
  <h2 class="flabel">Andere Leistungen in der Nähe</h2>
  <ul class="chips fchips">{pages.map((p) => <li><a class:list={["chip", { on: preset.current === p.href }]} href={u(p.href)}>{p.label}</a></li>)}</ul>
  </> : <>
  <h2 class="flabel">Rubriken</h2>
  <ul class="bedarf" role="group" aria-label="Rubrik auswählen">
    {bedarf.map((b, i) => (
      <li class={b.key === 'sanitaetshaus' ? 'bd-all' : ''}>{b.ohneKarte ? <a class="bd" href={u(`/${b.seite}/`)}><strong>{b.label}</strong>{b.hint && <small>{b.hint}</small>}</a> : <button type="button" class="bd" data-i={i} aria-pressed="false">
        <strong>{b.key === 'sanitaetshaus' ? 'Alle Sanitätshäuser' : b.label.replace('Kompressionsstrümpfe', 'Kompressions\u00ADstrümpfe')}</strong>{b.hint && <small>{b.hint}</small>}
      </button>}</li>
    ))}
  </ul></>}
  <p class="muted"><small>Kartendaten © OpenStreetMap-Mitwirkende. Leistungen laut Website der Betriebe, ohne Gewähr. Ihr Standort bleibt in Ihrem Browser.</small></p>
</section>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script is:inline>
  (async () => {
    const el = document.getElementById('f-map');
    const base = el.dataset.base, cats = JSON.parse(el.dataset.cats), BD = JSON.parse(el.dataset.bedarf);
    const $ = (id) => document.getElementById(id);
    const input = $('f-ort'), sug = $('f-sug'), rad = $('f-rad'), msg = $('f-msg'), list = $('f-list'), more = $('f-more');
    const root = $('finder');
    const dataP = fetch(el.dataset.src).then((r) => r.json());
    let data = null, map = null, pins = null;
    const ensureMap = () => {
      if (map) { map.invalidateSize(); return; }
      map = L.map(el, { scrollWheelZoom: false, preferCanvas: true, zoomSnap: 0.25 }).setView([51.2, 10.4], 6);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>' }).addTo(map);
      pins = L.featureGroup().addTo(map);
    };
    data = await dataP;
    // Kerndaten ins alte Zeilenformat bringen; Adresse und Kontakt kommen aus den Kacheln nach (ensureDetails)
    data.e = data.e.map((c, i) => { const r = [c[0], c[1], c[2], c[3], '', '', c[4], c[6] ? '…' : '', '', '', '', '', c[5]]; r.i = i; r.cell = `${Math.floor(c[1])}_${Math.floor(c[2])}`; return r; });
    const cellP = {};
    const ensureDetails = (rows) => Promise.all([...new Set(rows.map((r) => r.cell))].map((k) => (cellP[k] ||= fetch(`${base}data/f/${k}.json`).then((r) => r.json()).then((d) => {
      for (const [i, v] of Object.entries(d)) { const r = data.e[+i]; [r[4], r[5], r[7], r[8], r[9], r[10], r[11]] = v; }
    }).catch(() => { delete cellP[k]; }))));
    let drawTok = 0;
    const norm = (s) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/ß/g, 'ss');
    const orte = data.orte.map(([label, lat, lon, slug, n]) => ({ label, lat, lon, slug, n, k: norm(label) }));
    const plzKeys = Object.keys(data.plz);
    const km = (a, b) => { const r = Math.PI / 180, x = Math.sin((b.lat - a.lat) * r / 2) ** 2 + Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin((b.lon - a.lon) * r / 2) ** 2; return 12742 * Math.asin(Math.sqrt(x)); };
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    let sel = -1, here = null, shown = 30;
    let circle = null, me = null;
    const pop = (e) => `${e[5] ? `<a href="${base}${e[5]}">${esc(e[3])}</a>` : `<strong>${esc(e[3])}</strong>`}<br><span style="color:${cats[e[0]].color}">${esc(cats[e[0]].one)}</span><br>${esc(e[4])}`;
    const actions = (e) => {
      const a = [];
      if (e[7]) a.push(`<a class="k k-tel" href="tel:${esc(e[7].replace(/[^+\d]/g, ''))}">☎ ${esc(e[7])}</a>`);
      a.push(`<a class="k" href="https://www.google.com/maps/dir/?api=1&destination=${e[1]},${e[2]}" target="_blank" rel="nofollow noopener">Route</a>`);
      if (e[11]) a.push(`<a class="k k-book" href="${esc(e[11])}" target="_blank" rel="nofollow noopener">Online-Termin</a>`);
      if (e[10]) a.push(`<a class="k" href="mailto:${esc(e[10])}">E-Mail</a>`);
      if (e[9]) a.push(`<a class="k" href="${esc(e[9])}" target="_blank" rel="nofollow noopener">Website</a>`);
      return `<span class="facts">${a.join('')}</span>`;
    };
    // Jetzt geöffnet (einfaches OSM-Format, Zeitzone Berlin)
    const ORDER = ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'];
    const nowB = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Berlin' }));
    const today = ORDER[(nowB.getDay() + 6) % 7], nowMin = nowB.getHours() * 60 + nowB.getMinutes();
    function ohBadge(oh) {
      if (!oh) return '';
      let open = null;
      for (let part of oh.split(';').map((x) => x.trim()).filter(Boolean)) {
        part = part.replace(/,PH\b|\bPH,/g, '');
        if (/^PH\b/.test(part)) continue;
        const m = part.match(/^((?:Mo|Tu|We|Th|Fr|Sa|Su)(?:[-,](?:Mo|Tu|We|Th|Fr|Sa|Su))*)\s+(off|closed|(?:\d\d:\d\d-\d\d:\d\d,?\s*)+)$/);
        if (!m) return '';
        const days = [];
        for (const d of m[1].split(',')) { const [a, b] = d.split('-'); for (let k = ORDER.indexOf(a); k <= ORDER.indexOf(b ?? a); k++) days.push(ORDER[k]); }
        if (!days.includes(today)) continue;
        open = /off|closed/.test(m[2]) ? false : m[2].replace(/\s/g, '').split(',').some((t) => { const [a, b] = t.split('-').map((x) => +x.slice(0, 2) * 60 + +x.slice(3)); return nowMin >= a && nowMin < b; });
      }
      return open == null ? '' : `<span class="oh ${open ? 'open' : 'closed'}">${open ? 'jetzt geöffnet' : 'jetzt geschlossen'}</span>`;
    }
    const marker = (e, rr) => L.circleMarker([e[1], e[2]], { radius: rr, color: cats[e[0]].color, fillColor: cats[e[0]].color, fillOpacity: 0.85, weight: 1 }).bindPopup(pop(e));

    // Was: Rubrik (sel) oder freier Name (nameQ). Wo: here. Ohne Ort zeigt die Karte ganz Deutschland.
    const was = $('f-was'), wsug = $('f-wsug');
    const PRE = root.dataset.preset ? JSON.parse(root.dataset.preset) : null;
    const KEY = 'sh-ort';
    const BDN = BD.map((b, i) => ({ i, label: b.label, k: norm(b.label + ' ' + b.words) }));
    const ALL = BD.length - 1;
    let nameQ = '';
    const pickRubrik = (i) => { sel = i; nameQ = ''; was.value = BD[i].label; document.querySelectorAll('.bedarf .bd').forEach((x) => { const on = +x.dataset.i === i; x.classList.toggle('on', on); x.setAttribute('aria-pressed', on); }); };
    const matches = () => {
      if (PRE) return data.e.filter((e) => (PRE.kind === 'cat' ? e[0] === PRE.i : PRE.kind === 'feat' ? e[0] === PRE.san && (e[12] & (1 << PRE.i)) : e[6] & (1 << PRE.i)));
      if (nameQ) { const q = norm(nameQ); return data.e.filter((e) => norm(e[3]).includes(q)); }
      const bit = 1 << (sel < 0 ? ALL : sel); return data.e.filter((e) => e[6] & bit);
    };
    const whatLabel = () => (PRE ? PRE.label : nameQ ? `„${nameQ}“` : BD[sel < 0 ? ALL : sel].label);
    async function draw() {
      const tok = ++drawTok;
      ensureMap();
      const r = +rad.value, all = matches();
      pins.clearLayers(); list.innerHTML = ''; more.hidden = true;
      if (circle) { circle.remove(); circle = null; }
      if (me) { me.remove(); me = null; }
      if (!here) {
        all.forEach((e) => pins.addLayer(marker(e, 2.5)));
        map.fitBounds([[47.3, 5.9], [55.0, 15.0]]);
        msg.textContent = (sel < 0 && !nameQ && !PRE) ? 'Geben Sie ein, was Sie brauchen und wo. Die Karte zeigt sofort, wer in der Nähe ist.' : `${whatLabel()}: Geben Sie jetzt Ihren Ort oder Ihre PLZ ein.`;
        return;
      }
      const dist = all.map((e) => ({ e, d: km(here, { lat: e[1], lon: e[2] }) })).sort((a, b) => a.d - b.d);
      let near = dist.filter((x) => x.d <= r);
      const wider = !near.length && dist.length > 0;
      if (wider) near = dist.slice(0, 5);
      // Ohne Telefon: hellgrau ans Ende
      await ensureDetails(near.map((x) => x.e));
      if (tok !== drawTok) return;
      near = [...near.filter((x) => x.e[7]), ...near.filter((x) => !x.e[7])];
      near.forEach((x) => pins.addLayer(x.e[7] ? marker(x.e, 7) : L.circleMarker([x.e[1], x.e[2]], { radius: 6, color: '#aaa', fillColor: '#ccc', fillOpacity: 0.8, weight: 1 }).bindPopup(pop(x.e))));
      circle = L.circle([here.lat, here.lon], { radius: r * 1000, color: '#0f6b57', weight: 1, dashArray: '5 4', fillOpacity: 0.04, interactive: false }).addTo(map);
      me = L.circleMarker([here.lat, here.lon], { radius: 8, color: '#fff', fillColor: '#d9480f', fillOpacity: 1, weight: 3 }).addTo(map);
      map.fitBounds(wider ? L.latLngBounds(near.map((x) => [x.e[1], x.e[2]])).extend([here.lat, here.lon]).pad(0.15) : circle.getBounds());
      const b = BD[sel < 0 ? ALL : sel];
      const extra = (nameQ || PRE) ? '' : b.leistung ? ` <a href="${base}leistung/${b.leistung}/">${esc(b.label)} nach Stadt</a>` : b.seite ? ` <a href="${base}${b.seite}/">${esc(b.label)} nach Stadt</a>` : '';
      msg.innerHTML = wider ? `Im Umkreis von ${r} km nichts gefunden. Die nächsten Adressen für ${esc(whatLabel())}:` : near.length ? `${esc(whatLabel())} bei ${esc(here.label)}, die nächsten zuerst.` : `Nichts gefunden im Umkreis von ${r} km. Vergrößern Sie den Umkreis.${extra}`;
      list.innerHTML = near.slice(0, shown).map(({ e, d }) => `<li${e[7] ? '' : ' class="nocontact"'}><a href="${base}${e[5]}"><strong>${esc(e[3])}</strong></a> <span class="fkm">${d.toFixed(1).replace('.', ',')} km</span>${ohBadge(e[8])}<br><span class="muted">${esc(cats[e[0]].one)} · ${esc(e[4])}</span>${actions(e)}</li>`).join('');
      if (here.slug) list.insertAdjacentHTML('beforeend', PRE && PRE.city ? `<li class="fcity"><a href="${base}${PRE.city.replace('{slug}', here.slug)}">${esc(PRE.label)} in ${esc(here.label)}: Übersicht für den Ort</a></li>` : `<li class="fcity"><a href="${base}stadt/${here.slug}/">Alles in ${esc(here.label)} auf einer Seite: Sanitätshäuser, Physiotherapie, Pflege, Krankenfahrten</a></li>`);
      if (near.length > shown) { more.hidden = false; more.innerHTML = '<button type="button" class="btn" id="f-mehr">Weitere anzeigen</button>'; $('f-mehr').onclick = () => { shown += 30; draw(); }; }
    }
    if (!PRE) document.querySelector('.bedarf').addEventListener('click', (ev) => {
      const btn = ev.target.closest('button'); if (!btn) return;
      pickRubrik(+btn.dataset.i); shown = 30; draw();
      root.scrollIntoView({ block: 'start', behavior: 'smooth' });
      if (!here) input.focus({ preventScroll: true });
    });
    const save = () => { try { localStorage.setItem(KEY, JSON.stringify({ here, r: rad.value })); } catch {} };
    rad.addEventListener('change', () => { shown = 30; save(); draw(); });
    const setHere = (h) => { here = h; shown = 30; save(); input.value = h.label; sug.hidden = true; input.setAttribute('aria-expanded', 'false'); draw(); };
    function plzHit(q) {
      if (data.plz[q]) return data.plz[q];
      for (const n of [3, 2]) {
        const p = plzKeys.filter((k) => k.startsWith(q.slice(0, n)));
        if (p.length) return data.plz[p.reduce((best, k) => (Math.abs(+k - +q) < Math.abs(+best - +q) ? k : best))];
      }
      return null;
    }
    // Vorschlagslisten für beide Felder
    function combo(inp, box, find, choose) {
      let hits = [], act = -1;
      const render = () => { box.innerHTML = hits.map((h, i) => `<li role="option" data-i="${i}" class="${i === act ? 'on' : ''}">${h.html || esc(h.label)}</li>`).join(''); box.hidden = !hits.length; inp.setAttribute('aria-expanded', String(!!hits.length)); };
      inp.addEventListener('input', () => { act = -1; hits = find(norm(inp.value.trim()), inp.value.trim()); render(); });
      inp.addEventListener('keydown', (ev) => {
        if (ev.key === 'ArrowDown' && hits.length) { act = (act + 1) % hits.length; render(); ev.preventDefault(); }
        else if (ev.key === 'ArrowUp' && hits.length) { act = (act - 1 + hits.length) % hits.length; render(); ev.preventDefault(); }
        else if (ev.key === 'Enter') { ev.preventDefault(); choose(hits.length ? hits[Math.max(act, 0)] : null); box.hidden = true; hits = []; }
        else if (ev.key === 'Escape') box.hidden = true;
      });
      box.addEventListener('mousedown', (ev) => { const li = ev.target.closest('li'); if (li) { ev.preventDefault(); choose(hits[+li.dataset.i]); box.hidden = true; hits = []; } });
      inp.addEventListener('blur', () => setTimeout(() => { box.hidden = true; }, 150));
    }
    if (!PRE) combo(was, wsug, (q, raw) => {
      if (q.length < 2) return [];
      const rub = BDN.filter((b) => b.k.split(/[\s&,-]+/).some((w) => w.startsWith(q)) || b.k.includes(q)).slice(0, 6).map((b) => ({ rub: b.i, label: b.label }));
      const names = [...new Set(data.e.filter((e) => norm(e[3]).includes(q)).map((e) => e[3]))].slice(0, 4).map((n) => ({ name: n, label: n, html: `${esc(n)} <small class="muted">Name</small>` }));
      return [...rub, ...names];
    }, (h) => {
      if (h && h.rub != null) pickRubrik(h.rub);
      else { const t = h ? h.name : was.value.trim(); if (!t) { sel = -1; nameQ = ''; } else { nameQ = t; sel = -1; was.value = t; document.querySelectorAll('.bedarf .bd').forEach((x) => x.classList.remove('on')); } }
      shown = 30; draw();
      if (!here) input.focus();
    });
    combo(input, sug, (q) => {
      if (/^\d{5}$/.test(q)) { const p = plzHit(q); return p ? [{ label: `PLZ ${q}`, lat: p[0], lon: p[1] }] : []; }
      if (q.length < 2) return [];
      return orte.filter((o) => o.k.includes(q)).sort((a, b) => (b.k.startsWith(q) - a.k.startsWith(q)) || b.n - a.n).slice(0, 8);
    }, (h) => { if (h) setHere(h); });
    root.querySelector('form').addEventListener('submit', (ev) => { ev.preventDefault(); draw(); });
    // Ort von der letzten Suche übernehmen (auch beim Wechsel zwischen Leistungen)
    try { const st = JSON.parse(localStorage.getItem(KEY) || 'null'); if (st && st.here) { here = st.here; input.value = here.label; if (st.r) rad.value = st.r; } } catch {}
    draw();
    // Gerätestandort: nur über die Standortfreigabe des Browsers. Angezeigt wird die nächste PLZ, gerechnet wird mit dem genauen Punkt. Keine IP-Ortung.
    const nearestPlz = (lat, lon) => { let best = null, bd = 1e9; for (const k of plzKeys) { const [a, b] = data.plz[k]; const d = (a - lat) ** 2 + ((b - lon) * 0.63) ** 2; if (d < bd) { bd = d; best = k; } } return best; };
    const nearestOrt = (lat, lon) => orte.reduce((best, o) => { const d = (o.lat - lat) ** 2 + ((o.lon - lon) * 0.63) ** 2; return d < best.d ? { o, d } : best; }, { o: null, d: 1e9 }).o;
    const locate = (silent) => {
      if (!navigator.geolocation) return;
      if (!silent) msg.textContent = 'Standort wird ermittelt …';
      navigator.geolocation.getCurrentPosition((p) => {
        const lat = p.coords.latitude, lon = p.coords.longitude, plz = nearestPlz(lat, lon), o = nearestOrt(lat, lon);
        setHere({ label: plz ? `PLZ ${plz}` : 'Ihrem Standort', lat, lon, slug: o ? o.slug : undefined });
      }, () => { if (!silent) msg.textContent = 'Standort nicht verfügbar, bitte Ort oder PLZ eingeben.'; }, { timeout: 10000, maximumAge: 600000 });
    };
    $('f-loc').addEventListener('click', () => locate(false));
    // Hat der Nutzer die Standortfreigabe für diese Seite schon erteilt und noch keinen Ort gesucht, gleich verwenden (ohne neue Abfrage)
    if (!here && navigator.permissions) navigator.permissions.query({ name: 'geolocation' }).then((st) => { if (st.state === 'granted' && !here) locate(true); }).catch(() => {});
  })();
</script>
<style is:global>
  .finder { margin: 12px 0 8px; scroll-margin-top: 12px; }
  .fsearch { display: grid; gap: 12px; }
  .fq { position: relative; min-width: 0; }
  .fq label { display: block; font-weight: 700; font-size: 1.1rem; margin-bottom: 4px; }
  .fq input { width: 100%; font: inherit; font-size: 1.15rem; padding: 13px 16px; border: 2px solid var(--line); border-radius: var(--radius); }
  .fq input:focus { outline: none; border-color: var(--brand); }
  .frow { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .fgo { margin-left: auto; border: 0; cursor: pointer; font-size: 1.05rem; padding: 11px 26px; }
  #f-loc { cursor: pointer; font-size: .95rem; background: var(--surface); color: var(--brand); border: 1px solid var(--brand); }
  .fsug { position: absolute; z-index: 1001; left: 0; right: 0; top: 100%; margin: 2px 0 0; padding: 0; list-style: none; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,.14); max-height: 300px; overflow: auto; }
  .fsug li { padding: 9px 14px; cursor: pointer; }
  .fsug li.on, .fsug li:hover { background: var(--accent); }
  .frad { display: flex; align-items: center; gap: 8px; font-size: .95rem; font-weight: 600; }
  .frad select { font: inherit; padding: 7px 10px; border: 2px solid var(--brand); border-radius: 8px; background: var(--surface); }
  .fhead { margin: 14px 0 0; font-size: 1.05rem; }
  #f-map { height: 420px; border-radius: var(--radius); border: 1px solid var(--line); margin: 10px 0 12px; z-index: 0; }
  .flabel { margin: 22px 0 10px; font-size: 1.25rem; }
  .bedarf { list-style: none; padding: 0; margin: 0 0 10px; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; }
  a.bd { display: block; box-sizing: border-box; text-decoration: none; }
  .bd { width: 100%; height: 100%; text-align: left; font: inherit; background: var(--bg); color: var(--text); border: 1px solid var(--line); border-radius: var(--radius); padding: 10px 14px; cursor: pointer; }
  .bd strong { display: block; font-size: 1rem; line-height: 1.3; hyphens: auto; overflow-wrap: break-word; }
  .bd-all { grid-column: 1 / -1; }
  .bd-all .bd { background: none; border-style: dashed; text-align: center; padding: 8px; }
