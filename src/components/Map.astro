---
// Karte mit OpenStreetMap-Kacheln (Leaflet). Lädt erst, wenn sie ins Bild scrollt.
import { u } from '../lib/url';
interface Props { shops: { lat?: number; lon?: number; name: string; slug?: string }[]; color?: string }
const color = Astro.props.color ?? '#0f6b57';
const points = Astro.props.shops.filter((s) => s.lat).map((s) => [s.lat, s.lon, s.name, s.slug ? u(`/sanitaetshaus/${s.slug}/`) : '']);
---
{points.length > 0 && (
  <div class="map" data-color={color} data-points={JSON.stringify(points)} role="region" aria-label="Karte der Sanitätshäuser"></div>
)}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js" defer></script>
<script>
  const init = (el: HTMLElement) => {
    const L = (window as any).L;
    if (!L) return void setTimeout(() => init(el), 200);
    const pts: [number, number, string, string][] = JSON.parse(el.dataset.points!);
    const map = L.map(el, { scrollWheelZoom: false });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>' }).addTo(map);
    const markers = pts.map(([lat, lon, name, href]) => {
      const a = document.createElement(href ? 'a' : 'span'); if (href) (a as HTMLAnchorElement).href = href; a.textContent = name;
      return L.circleMarker([lat, lon], { radius: 7, color: el.dataset.color, fillOpacity: 0.8 }).bindPopup(a).addTo(map);
    });
    map.fitBounds(L.featureGroup(markers).getBounds().pad(0.15), { maxZoom: 15 });
  };
  const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { io.unobserve(e.target); init(e.target as HTMLElement); } }));
  document.querySelectorAll<HTMLElement>('.map').forEach((el) => io.observe(el));
</script>
<style>.map { height: 340px; border-radius: var(--radius); border: 1px solid var(--line); margin: 14px 0; z-index: 0; }</style>
