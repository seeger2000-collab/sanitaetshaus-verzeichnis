---
// Eintrag ohne eigene Detailseite (Physiotherapie, Pflegedienst, Krankenfahrten)
import type { Provider } from '../lib/data';
import { categories } from '../lib/data';
import { formatHours } from '../lib/hours';
interface Props { p: Provider; showCity?: boolean; km?: number }
const { p, showCity = false, km } = Astro.props;
const cat = categories.find((c) => c.key === p.cat)!;
const label = Object.fromEntries(cat.features.map((f) => [f.key, f.short]));
const place = [p.postcode, p.postcode || showCity ? p.city : null].filter(Boolean).join(' ');
const address = [p.street, place].filter(Boolean).join(', ');
const hours = p.openingHours ? formatHours(p.openingHours) : null;
const mapUrl = p.lat ? `https://www.openstreetmap.org/?mlat=${p.lat}&mlon=${p.lon}#map=18/${p.lat}/${p.lon}` : null;
---
<li class="shop" data-features={p.features.join(' ')} data-wheelchair={p.wheelchair === 'yes' ? '1' : ''}>
  <article class="card">
    <h3 data-oh={p.openingHours ?? undefined}>{p.name}</h3>
    <p class="addr">{address}{km != null && ` · ${km < 1 ? 'unter 1' : Math.round(km)} km`}{p.wheelchair === 'yes' && <span class="acc">{address ? ' · ' : ''}barrierefrei</span>}</p>
    {p.features.length > 0 && (
      <ul class="chips">{p.features.map((f) => <li class="chip">{p.evidence?.[f] ? <a href={p.evidence[f]} rel="nofollow noopener" target="_blank" title="Quelle auf der Website">{label[f]}</a> : label[f]}</li>)}</ul>
    )}
    {hours && <p class="hours">{hours.join(' · ')}{p.hoursSource === 'website' && ' (laut Website)'}</p>}
    <p class="links">
      {p.phone && <a href={`tel:${p.phone.split(';')[0].replace(/[^+\d]/g, '')}`}>{p.phone.split(';')[0]}</a>}
      {p.website && <a href={p.website} rel="nofollow noopener" target="_blank">Website</a>}
      {mapUrl && <a href={mapUrl} rel="nofollow noopener" target="_blank">Karte</a>}
    </p>
  </article>
</li>
<style>
  .shop { list-style: none; }
  h3 { margin: 0 0 4px; font-size: 1.1rem; }
  .addr, .hours { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .hours { font-size: 0.85rem; margin-top: 4px; }
  .acc { color: var(--brand); }
  .chip a { color: inherit; text-decoration: none; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 6px 0 0; font-size: 0.95rem; }
</style>
