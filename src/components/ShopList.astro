---
// Liste mit Filter nach Leistung (läuft im Browser, ohne Neuladen)
import type { Shop } from '../lib/data';
import { features } from '../lib/data';
import ShopCard from './ShopCard.astro';
interface Props { shops: Shop[]; showCity?: boolean; filter?: boolean }
const { shops, showCity = false, filter = true } = Astro.props;
const available = features.filter((f) => shops.some((s) => s.features.includes(f.key)));
---
<div class="shoplist">
  {filter && available.length > 0 && (
    <fieldset class="filter">
      <legend>Nach Leistung filtern</legend>
      {available.map((f) => (
        <label><input type="checkbox" value={f.key} /> {f.label}</label>
      ))}
      <label><input type="checkbox" value="__wheelchair" /> barrierefrei</label>
      <p class="count" aria-live="polite"><span>{shops.length}</span> von {shops.length} Sanitätshäusern</p>
    </fieldset>
  )}
  <ul class="list">
    {shops.map((s) => <ShopCard shop={s} showCity={showCity} />)}
  </ul>
  <p class="empty" hidden>Kein Sanitätshaus erfüllt alle gewählten Leistungen. Nimm einen Filter heraus.</p>
</div>
<style>
  .filter { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 10px 14px 6px; margin: 0 0 14px; display: flex; flex-wrap: wrap; gap: 4px 18px; }
  legend { font-weight: 600; padding: 0 4px; }
  label { font-size: 0.95rem; cursor: pointer; }
  .count { width: 100%; margin: 6px 0 0; color: var(--muted); font-size: 0.9rem; }
  .list { display: grid; gap: 10px; padding: 0; margin: 0; }
</style>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('.shoplist')) {
    const boxes = [...root.querySelectorAll<HTMLInputElement>('.filter input')];
    const items = [...root.querySelectorAll<HTMLElement>('li.shop')];
    const counter = root.querySelector('.count span');
    const empty = root.querySelector<HTMLElement>('.empty')!;
    const apply = () => {
      const wanted = boxes.filter((b) => b.checked).map((b) => b.value);
      let n = 0;
      for (const li of items) {
        const have = (li.dataset.features || '').split(' ');
        const ok = wanted.every((w) => (w === '__wheelchair' ? li.dataset.wheelchair === '1' : have.includes(w)));
        li.hidden = !ok;
        if (ok) n++;
      }
      if (counter) counter.textContent = String(n);
      empty.hidden = n > 0;
    };
    boxes.forEach((b) => b.addEventListener('change', apply));
  }
</script>
