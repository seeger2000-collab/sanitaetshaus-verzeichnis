---
import type { Provider } from '../lib/data';
import { categories } from '../lib/data';
import ProviderCard from './ProviderCard.astro';
interface Props { items: { p: Provider; km?: number }[]; cat: string; showCity?: boolean; filter?: boolean }
const { items, cat, showCity = false, filter = true } = Astro.props;
const feats = categories.find((c) => c.key === cat)!.features.filter((f) => items.some((i) => i.p.features.includes(f.key)));
---
<div class="shoplist providerlist">
  {filter && feats.length > 0 && items.length > 3 && (
    <fieldset class="filter">
      <legend>Filtern</legend>
      {feats.map((f) => <label><input type="checkbox" value={f.key} /> {f.label}</label>)}
      <label><input type="checkbox" value="__wheelchair" /> barrierefrei</label>
      <p class="count" aria-live="polite"><span>{items.length}</span> von {items.length}</p>
    </fieldset>
  )}
  <ul class="list">{items.map((i) => <ProviderCard p={i.p} km={i.km} showCity={showCity} />)}</ul>
  <p class="empty" hidden>Kein Eintrag erfüllt alle gewählten Merkmale.</p>
</div>
<style>
  .filter { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 10px 14px 6px; margin: 0 0 14px; display: flex; flex-wrap: wrap; gap: 4px 18px; }
  legend { font-weight: 600; padding: 0 4px; }
  label { font-size: 0.95rem; cursor: pointer; }
  .count { width: 100%; margin: 6px 0 0; color: var(--muted); font-size: 0.9rem; }
  .list { display: grid; gap: 10px; padding: 0; margin: 0; }
</style>
<script>
  for (const root of document.querySelectorAll<HTMLElement>(".providerlist")) {
    const boxes = [...root.querySelectorAll<HTMLInputElement>('.filter input')];
    if (!boxes.length) continue;
    const items = [...root.querySelectorAll<HTMLElement>('li.shop')];
    const counter = root.querySelector('.count span');
    const empty = root.querySelector<HTMLElement>('.empty')!;
    const apply = () => {
      const wanted = boxes.filter((b) => b.checked).map((b) => b.value);
      let n = 0;
      for (const li of items) {
        const have = (li.dataset.features || '').split(' ');
        const ok = wanted.every((w) => (w === '__wheelchair' ? li.dataset.wheelchair === '1' : have.includes(w)));
        li.hidden = !ok; if (ok) n++;
      }
      if (counter) counter.textContent = String(n);
      empty.hidden = n > 0;
    };
    boxes.forEach((b) => b.addEventListener('change', apply));
  }
</script>
