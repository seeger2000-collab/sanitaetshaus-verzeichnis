---
// Zeigt "jetzt geöffnet" / "geschlossen" an allen Elementen mit data-oh (einfaches OSM-Format), Zeitzone Berlin.
---
<script>
  const ORDER = ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'];
  function parse(oh: string) {
    const week: Record<string, [number, number][]> = {};
    for (const part of oh.split(';').map((p) => p.trim()).filter(Boolean)) {
      if (/^PH\b/.test(part)) continue;
      const m = part.match(/^((?:Mo|Tu|We|Th|Fr|Sa|Su)(?:[-,](?:Mo|Tu|We|Th|Fr|Sa|Su))*)\s+(off|closed|(?:\d\d:\d\d-\d\d:\d\d,?\s*)+)$/);
      if (!m) return null;
      const days: string[] = [];
      for (const d of m[1].split(',')) {
        const [a, b] = d.split('-');
        const i = ORDER.indexOf(a), j = ORDER.indexOf(b ?? a);
        for (let k = i; k <= j; k++) days.push(ORDER[k]);
      }
      const slots = /off|closed/.test(m[2]) ? [] : m[2].replace(/\s/g, '').split(',').map((s) => s.split('-').map((t) => +t.slice(0, 2) * 60 + +t.slice(3)) as [number, number]);
      for (const d of days) week[d] = slots;
    }
    return week;
  }
  const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Berlin' }));
  const day = ORDER[(now.getDay() + 6) % 7];
  const min = now.getHours() * 60 + now.getMinutes();
  for (const el of document.querySelectorAll<HTMLElement>('[data-oh]')) {
    const week = parse(el.dataset.oh!);
    if (!week) continue;
    const open = (week[day] || []).some(([a, b]) => min >= a && min < b);
    const badge = document.createElement('span');
    badge.className = open ? 'oh-badge open' : 'oh-badge closed';
    badge.textContent = open ? 'jetzt geöffnet' : 'jetzt geschlossen';
    el.append(badge);
  }
</script>
<style is:global>
  .oh-badge { display: inline-block; margin-left: 8px; padding: 1px 8px; border-radius: 999px; font-size: 0.78rem; font-weight: 600; vertical-align: middle; }
  .oh-badge.open { background: #e3f4e8; color: #17663a; }
  .oh-badge.closed { background: #f3eded; color: #8a2d2d; }
</style>
